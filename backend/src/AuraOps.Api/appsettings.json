{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=AuraOps;User Id=auraops_app;Password=__set_via_environment__;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": true
  },
  "Jwt": {
    "Issuer": "AuraOps",
    "Audience": "AuraOps.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 10
  },
  "Seed": {
    "DemoData": false
  },
  "Swagger": {
    "Enabled": false
  }
}
