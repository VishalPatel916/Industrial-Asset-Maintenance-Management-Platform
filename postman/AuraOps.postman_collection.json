            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetCode\": \"PM-{{$randomInt}}\",\n  \"name\": \"Postman Pump\",\n  \"category\": \"Pump\",\n  \"location\": \"Plant A / Line 9\",\n  \"status\": \"Operational\",\n  \"purchaseDate\": \"2024-01-15\",\n  \"description\": \"Created from Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
