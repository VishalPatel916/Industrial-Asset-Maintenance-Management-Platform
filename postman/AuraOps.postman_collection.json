              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('has field errors', () => pm.expect(pm.response.json().errors).to.have.property('AssetCode'));"
