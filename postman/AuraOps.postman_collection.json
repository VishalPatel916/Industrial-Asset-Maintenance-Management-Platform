{
  "info": {
    "name": "AuraOps API",
    "description": "Run 'Auth' first. The workflow folder runs in order (Collection Runner) and exercises the full maintenance flow plus negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "techToken",
      "value": ""
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "technicianId",
      "value": ""
    },
    {
      "key": "assetId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "workOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Viewer (manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@auraops.local\",\n  \"password\": \"Demo123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('viewerToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "if (pm.response.json().user.roles.includes('Technician')) pm.collectionVariables.set('technicianId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Technician",
